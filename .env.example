# Session & Authentication
# Leave SESSION_ID blank to generate a QR Code or use Pairing Code below
SESSION_ID=
PAIRING_CODE_NUMBER=

# Owner & Bot Identity
BOT_NAME=Fredrik
PREFIX=.
OWNER_NUMBER=auto
MODE=public

# OpenRouter AI Configuration
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_SITE_URL=https://github.com/fredrik-bot
